# Copy this file to .env; .env is ignored by Git.
# Docker: docker compose up --build
# Local: uv run --env-file .env streamlit run app.py
# Empty API key keeps the application in deterministic/offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set ALL THREE values below to restrict access. Leave ALL empty for a labeled demo.
CQ_EMPLOYEE_ID=
CQ_EMPLOYEE_PASSWORD=
CQ_HR_PASSWORD=
CQ_PORT=8501
